    26	import org.springframework.web.bind.annotation.InitBinder;
    27	import org.springframework.web.bind.annotation.ModelAttribute;
    28	import org.springframework.web.bind.annotation.PathVariable;
    29	import org.springframework.web.bind.annotation.PostMapping;
    30	
    31	import jakarta.validation.Valid;
    32	import org.springframework.web.servlet.mvc.support.RedirectAttributes;
    33	
    34	/**
    35	 * @author Juergen Hoeller
    36	 * @author Ken Krebs
    37	 * @author Arjen Poutsma
    38	 * @author Michael Isvy
    39	 * @author Dave Syer
    40	 * @author Wick Dynex
    41	 */
    42	@Controller
    43	class VisitController {
    44	
    45		private final OwnerRepository owners;
    46	
    47		public VisitController(OwnerRepository owners) {
    48			this.owners = owners;
    49		}
    50	
    51		@InitBinder
    52		public void setAllowedFields(WebDataBinder dataBinder) {
    53			dataBinder.setDisallowedFields("id", "*.id");
    54		}
    55	
    56		/**
    57		 * Called before each and every @RequestMapping annotated method. 2 goals: - Make sure
    58		 * we always have fresh data - Since we do not use the session scope, make sure that
    59		 * Pet object always has an id (Even though id is not part of the form fields)
    60		 * @param petId
    61		 * @return Pet
    62		 */
    63		@ModelAttribute("visit")
    64		public Visit loadPetWithVisit(@PathVariable("ownerId") int ownerId, @PathVariable("petId") int petId,
    65				Map<String, Object> model) {
    66			Optional<Owner> optionalOwner = owners.findById(ownerId);
    67			Owner owner = optionalOwner.orElseThrow(() -> new IllegalArgumentException(
    68					"Owner not found with id: " + ownerId + ". Please ensure the ID is correct "));
    69	
    70			Pet pet = owner.getPet(petId);
    71			if (pet == null) {
    72				throw new IllegalArgumentException(
    73						"Pet with id " + petId + " not found for owner with id " + ownerId + ".");
    74			}
    75			model.put("pet", pet);
    76			model.put("owner", owner);
    77	
    78			Visit visit = new Visit();
    79			pet.addVisit(visit);
    80			return visit;
    81		}
    82	
    83		@ModelAttribute("minVisitDate")
    84		public LocalDate minVisitDate() {
    85			return LocalDate.now().plusDays(1);
    86		}
    87	
    88		// Spring MVC calls method loadPetWithVisit(...) before initNewVisitForm is
    89		// called
    90		@GetMapping("/owners/{ownerId}/pets/{petId}/visits/new")
    91		public String initNewVisitForm() {
    92			return "pets/createOrUpdateVisitForm";
    93		}
    94	
    95		// Spring MVC calls method loadPetWithVisit(...) before processNewVisitForm is
    96		// called
    97		@PostMapping("/owners/{ownerId}/pets/{petId}/visits/new")
    98		public String processNewVisitForm(@ModelAttribute Owner owner, @PathVariable int petId, @Valid Visit visit,
    99				BindingResult result, RedirectAttributes redirectAttributes) {
   100			if (visit.getDate() != null && !visit.getDate().isAfter(LocalDate.now())) {
   101				result.rejectValue("date", "typeMismatch.visitDate");
   102			}
   103	
   104			if (result.hasErrors()) {
   105				return "pets/createOrUpdateVisitForm";
   106			}
   107	
   108			owner.addVisit(petId, visit);
   109			this.owners.save(owner);
   110			redirectAttributes.addFlashAttribute("message", "Your visit has been booked");
   111			return "redirect:/owners/{ownerId}";
   112		}
   113	
   114	}
