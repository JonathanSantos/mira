   169	        exceedMin = isTime
   170	          ? convertTimeToDate(inputValue) < convertTimeToDate(minOutput.value)
   171	          : isWeek
   172	            ? inputValue < minOutput.value
   173	            : valueDate < new Date(minOutput.value);
